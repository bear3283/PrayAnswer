# 이 파일을 fastlane/.env 로 복사해서 값을 채운다.
# .env 는 gitignore 되어 있다 — 저장소가 공개이므로 절대 커밋하지 말 것.
#
#   cp fastlane/.env.example fastlane/.env
#
# 값은 App Store Connect → 사용자 및 액세스 → 통합 → App Store Connect API 에서 확인한다.

# 키 ID — 내려받은 파일명 AuthKey_XXXXXXXXXX.p8 의 XXXXXXXXXX 부분
ASC_KEY_ID=

# 발급자 ID (Issuer ID) — API 키 목록 상단에 표시되는 UUID
ASC_ISSUER_ID=

# .p8 키 파일의 절대 경로.
# 이 파일은 한 번만 내려받을 수 있으니 저장소 밖 안전한 곳에 두고 경로만 적는다.
ASC_KEY_PATH=
